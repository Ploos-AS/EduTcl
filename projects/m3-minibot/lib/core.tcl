namespace eval ::minibot::core { variable state idle; variable scheduled 0; variable started 0; variable outputPrefix {} }
proc ::minibot::core::state {} { variable state; return $state }
proc ::minibot::core::emit {text} { variable outputPrefix; if {[llength $outputPrefix]} {{*}$outputPrefix $text}; return $text }
proc ::minibot::core::start {{output {}} {limit 16}} { variable state; variable started; variable outputPrefix; if {$state ni {idle closed}} {return -code error -errorcode [list MINIBOT STATE $state running] "cannot start from $state"}; set outputPrefix $output; ::minibot::queue::configure $limit; ::minibot::queue::reset; ::minibot::timers::cancel_all; set started [clock milliseconds]; set state running; return $state }
proc ::minibot::core::submit {command args} { variable state; variable scheduled; if {$state ne "running"} {return -code error -errorcode [list MINIBOT STATE $state] "bot is not running"}; ::minibot::queue::push [list $command {*}$args]; if {!$scheduled} {set scheduled 1; after 0 ::minibot::core::drain}; return [::minibot::queue::size] }
proc ::minibot::core::drain {} { variable state; variable scheduled; set scheduled 0; if {$state ne "running"} {return}; if {[::minibot::queue::size]} {set event [::minibot::queue::pop]; if {[catch {::minibot::registry::dispatch {*}$event} result]} {emit "error: $result"} else {emit $result}}; if {$state eq "running" && [::minibot::queue::size]} {set scheduled 1; after 0 ::minibot::core::drain} }
proc ::minibot::core::uptime {} { variable started; expr {[clock milliseconds]-$started} }
proc ::minibot::core::stop {} { variable state; variable scheduled; if {$state eq "closed"} {return closed}; set state stopping; ::minibot::timers::cancel_all; ::minibot::queue::reset; set scheduled 0; set state closed; return $state }

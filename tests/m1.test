package require tcltest
namespace import ::tcltest::*

set here [file dirname [file normalize [info script]]]
source [file join $here .. projects m1-minibot minibot.tcl]

proc reset_state {} {
    set ::minibot::state [dict create count 0 channels [list "#tcl" "#eggdrop"]]
}

test normalize-1 {trim and lowercase command names} -body {
    ::minibot::normalize "  HeLP "
} -result help

test dispatch-hello-1 {default greeting} -setup reset_state -body {
    ::minibot::dispatch hello
} -result {Hello, world}

test dispatch-hello-2 {argument remains data} -setup reset_state -body {
    ::minibot::dispatch hello {$x[puts nope];}
} -result {Hello, $x[puts nope];}

test dispatch-help-1 {help returns a proper list} -setup reset_state -body {
    ::minibot::dispatch help
} -result {hello help about count channels quit}

test dispatch-count-1 {commands increment counter} -setup reset_state -body {
    ::minibot::dispatch about
    ::minibot::dispatch count
} -result 2

test dispatch-unknown-1 {unknown commands are explicit errors} -setup reset_state -body {
    ::minibot::dispatch nosuch
} -returnCodes error -result {unknown command: nosuch}

test channels-1 {channel state is structured list data} -setup reset_state -body {
    set channels [::minibot::dispatch channels]
    list [llength $channels] [lindex $channels 0] [lindex $channels 1]
} -result {2 #tcl #eggdrop}

test unicode-1 {Unicode survives as data} -setup reset_state -body {
    ::minibot::dispatch hello "Blåbær"
} -result {Hello, Blåbær}

test persistence-1 {state round trip} -setup {
    reset_state
    set tmp [makeFile "" minibot-state]
} -body {
    ::minibot::dispatch about
    ::minibot::save $tmp
    set ::minibot::state [dict create count 99 channels {}]
    ::minibot::load $tmp
    dict get $::minibot::state count
} -cleanup {
    removeFile $tmp
} -result 1

test adversarial-1 {Tcl-looking values remain inert data} -setup reset_state -body {
    set payload {$name [error BOOM] ; puts BAD \\ {braces}}
    ::minibot::dispatch hello $payload
} -result {Hello, $name [error BOOM] ; puts BAD \\ {braces}}

test persistence-invalid-1 {invalid persisted state is rejected and old state survives} -setup {
    reset_state
    set tmp [makeFile "not-a-dictionary" minibot-invalid-state]
} -body {
    set before $::minibot::state
    set code [catch {::minibot::load $tmp} message]
    list $code $message [expr {$::minibot::state eq $before}]
} -cleanup {
    removeFile $tmp
} -result {1 {invalid MiniBot state} 1}

test persistence-missing-1 {missing state file is an observable error} -setup {
    reset_state
    set tmp [makeFile "" minibot-missing-state]
    removeFile $tmp
} -body {
    catch {::minibot::load $tmp} message
} -result 1

cleanupTests

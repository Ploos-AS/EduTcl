package require tcltest 2
namespace import ::tcltest::*
set here [file dirname [file normalize [info script]]]
source [file join $here .. projects m6-api-lab api_lab.tcl]

test m6-bot-1 {bot facts are explicit host state} -body {
    ::m6host::reset
    ::m6host::set_bot connected 1
    list [::m6host::bot connected] [::m6host::bot nick]
} -result {1 EduBot}

test m6-channel-1 {membership is runtime state} -body {
    ::m6host::reset
    ::m6host::join #tcl Alice alice
    ::m6host::join #tcl Bob bob
    set before [lsort [::m6host::members #tcl]]
    ::m6host::part #tcl Alice
    list $before [::m6host::members #tcl]
} -result {{Alice Bob} Bob}

test m6-flags-1 {authorization follows handle flags not nick} -body {
    ::m6host::reset
    ::m6host::set_flags alice m
    list [::m6host::has_flag alice m] [::m6host::has_flag bob m]
} -result {1 0}

test m6-timer-1 {timer ownership can be cancelled} -body {
    ::m6host::reset
    set id [::m6host::timer_add 10 {::module::tick}]
    set before [dict exists [::m6host::timers] $id]
    set cancelled [::m6host::timer_cancel $id]
    list $before $cancelled [dict size [::m6host::timers]]
} -result {1 1 0}

test m6-timer-2 {invalid timer delay is rejected} -body {
    catch {::m6host::timer_add -1 noop} m o
    dict get $o -errorcode
} -result {M6 TIMER DELAY}

test m6-output-1 {normal output is recorded by intent} -body {
    ::m6host::reset
    ::m6host::send help #tcl {hello}
    dict get [lindex [::m6host::output] 0] queue
} -result help

test m6-output-2 {protocol injection is rejected} -body {
    ::m6host::reset
    catch {::m6host::send normal #tcl "hello\r\nOPER root"} m o
    dict get $o -errorcode
} -result {M6 OUTPUT UNSAFE}

test m6-log-1 {structured log event is recorded} -body {
    ::m6host::reset
    ::m6host::log info toolkit started
    dict get [lindex [::m6host::logs] 0] event
} -result started

test m6-bind-1 {owner teardown removes only owned callbacks} -body {
    ::m6host::reset
    ::m6host::bind_own alpha pub !a ::a
    ::m6host::bind_own beta pub !b ::b
    set n [::m6host::unbind_owner alpha]
    list $n [llength [::m6host::binds]] [lindex [lindex [::m6host::binds] 0] 0]
} -result {1 1 beta}

test m6-path-1 {child path remains below root} -body {
    set root [file join [pwd] m6data]
    string equal [::m6host::safe_child_path $root notes/a.txt] [file normalize [file join $root notes a.txt]]
} -result 1

test m6-path-2 {path traversal is rejected} -body {
    set root [file join [pwd] m6data]
    catch {::m6host::safe_child_path $root ../secret} m o
    dict get $o -errorcode
} -result {M6 PATH ESCAPE}

test m6-capability-1 {optional capability is explicit} -body {
    ::m6host::reset
    set before [::m6host::has_capability dns]
    ::m6host::provide dns
    list $before [::m6host::has_capability dns]
} -result {0 1}

test m6-async-1 {cancelled request rejects late result} -body {
    ::m6host::reset
    set id [::m6host::request_start dns [dict create channel #tcl]]
    ::m6host::request_cancel $id
    catch {::m6host::request_complete $id 127.0.0.1} m o
    dict get $o -errorcode
} -result {M6 REQUEST STALE}

test m6-async-2 {completion consumes request ownership} -body {
    ::m6host::reset
    set id [::m6host::request_start dns [dict create channel #tcl]]
    set result [::m6host::request_complete $id 127.0.0.1]
    list [dict get $result result] [dict size [::m6host::requests]]
} -result {127.0.0.1 0}

test m6-botnet-1 {unknown protocol version fails closed} -body {
    catch {::m6host::bot_message 99 status hello} m o
    dict get $o -errorcode
} -result {M6 BOTNET VERSION}

test m6-botnet-2 {payload remains data} -body {
    set m [::m6host::bot_message 1 event {[error BOOM]; puts BAD}]
    dict get $m payload
} -result {[error BOOM]; puts BAD}

cleanupTests
